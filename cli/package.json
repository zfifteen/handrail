{
  "name": "handrail",
  "version": "0.1.0",
  "description": "Local-first iOS remote control for Grok Build chats.",
  "type": "module",
  "bin": {
    "handrail": "./dist/src/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "spike": "tsx spike/run-all.ts",
